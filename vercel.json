{
    "functions": {
        "api/**": {
            "runtime": "@vercel/node@^3"
        },
        "functions/**": {
            "runtime": "@vercel/node@^3"
        }
    },
    "env": {
        "NODE_OPTIONS": "--experimental-fetch"
    },
    "rewrites": [
        {
            "source": "/my",
            "destination": "/my.html"
        }
    ]
}
